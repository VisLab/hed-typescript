# Logs
logs
*.log
npm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

## Custom

# JSON spec test files
spec_tests/*.txt
spec_tests/temp*.json
spec_tests/temp.spec.js
tests/temp.spec.js

# Build
built/
dist/
/docs/_build/

# IDEs; .vscode/settings.json is committed (portable settings only)
.idea/
.vscode/*
!.vscode/settings.json

# Working notes, plans, and decision records. Deliberately not committed:
# this repo is public and .status/ holds half-formed thinking. It lives on one
# machine only and is absent from fresh clones and worktrees.
.status/

# Personal Claude Code notes and settings (absolute paths)
CLAUDE.local.md
.claude/settings.local.json

# Real tokens and machine values
.env
